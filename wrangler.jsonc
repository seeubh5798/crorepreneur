// Cloudflare Workers. The site is the plain files `npm run build` writes to
// out/, served as static assets: /about serves about.html, and an address
// that matches no file gets 404.html. Only /api/* runs the script in
// worker/, which sends the enquiry emails.
{
  "name": "crorepreneur",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The public key of the form's spam check (Cloudflare Turnstile). With it,
    // and the secrets RESEND_API_KEY and TURNSTILE_SECRET_KEY set on the Worker
    // in Cloudflare, the form sends enquiries itself. Without any of the three,
    // it opens the visitor's email app instead.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFjy5R8IZYOqMRPC"
  },
  // Keeps the script's logs (a failed email, say) in the Worker's dashboard.
  "observability": {
    "enabled": true
  }
}
